{
    "name": "thenextweb/passgenerator",
    "description": "A Laravel package to create Apple Wallet (old Passbook) compatible tickets.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "php",
        "laravel",
        "Apple",
        "Passbook"
    ],
    "authors": [
        {
            "name": "The Next Web BV",
            "email": "support@thenextweb.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-openssl": "*",
        "ext-zip": "*",
        "illuminate/filesystem": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/validation": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.2",
        "orchestra/testbench": "^5.0|^6.0|^7.0|^8.0|^9.0|^10.0",
        "phpstan/phpstan": "^1.6",
        "phpunit/phpunit": "^9.3|^10.0|^11.5",
        "rector/rector": "^0.12|^0.15"
    },
    "autoload": {
        "psr-4": {
            "Thenextweb\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Thenextweb\\PassGeneratorServiceProvider"
            ],
            "aliases": {
                "PassGenerator": "Thenextweb\\Facades\\PassGenerator"
            }
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    }
}